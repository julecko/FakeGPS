<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Target crosshair: its center is at the exact center of the screen / map -->
    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_pin"
        android:importantForAccessibility="no" />

    <!-- Mode switch -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeSingleBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/mode_single" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeRouteBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:text="@string/mode_route" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- Help button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/helpBtn"
        style="@style/Widget.Material3.FloatingActionButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/show_tutorial"
        app:fabCustomSize="32dp"
        app:maxImageSize="18dp"
        app:srcCompat="@drawable/ic_help" />

    <!-- Center on real GPS location (hidden while faking) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/myLocationBtn"
        style="@style/Widget.Material3.FloatingActionButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/center_on_me"
        app:fabCustomSize="32dp"
        app:maxImageSize="18dp"
        app:srcCompat="@drawable/ic_my_location" />

    <!-- Bottom control card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/routeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:id="@+id/routeButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addPointBtn"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/route_add_point"
                        app:icon="@drawable/ic_add_location" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/undoBtn"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/route_undo"
                        app:icon="@drawable/ic_undo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearBtn"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/route_clear"
                        app:icon="@drawable/ic_delete" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speedBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_speed" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mockToggleBtn"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:text="@string/start_faking"
                android:textSize="18sp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="@android:color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
